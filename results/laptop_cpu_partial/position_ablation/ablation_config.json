{
  "name": "position_ablation",
  "output": "results/position_ablation",
  "description": "Stage 2: input features only. Same data, budget, optimizer, objective and mode as the data-scaling winner. bit_only is the baseline.",
  "data": {
    "train_size": 45000,
    "val_size": 256,
    "validation_size": 5000
  },
  "model": {
    "embedding_dim": 32,
    "hidden_size": 128,
    "num_layers": 2
  },
  "training": {
    "epochs": 100000,
    "max_steps": 6400,
    "val_every": 800,
    "batch_size": 32,
    "chunk_length": 256,
    "learning_rate": 0.001,
    "mode": "teacher_forcing",
    "objective": "bce",
    "lr_schedule": "constant",
    "device": "cpu",
    "seed": 42
  },
  "sweep": {
    "split": "val",
    "size": 200,
    "engine": "qgru-v2"
  },
  "variants": [
    {
      "name": "bit_only"
    },
    {
      "name": "bit_plane",
      "model": {
        "plane_dim": 8
      }
    },
    {
      "name": "bit_plane_rowcol",
      "model": {
        "plane_dim": 8,
        "row_dim": 8,
        "col_dim": 8
      }
    }
  ]
}